[resource]
script = ExtResource("1_script")
location_id = "haskalVillage"
location_name = "Hascal Village"
description = "A hidden mining village tucked in the valley. Gold and gemstones fuel the lives of its people."
lore = "Founded by miners who discovered the largest gold vein in the region. But mines dug too deep opened a gateway to another dimension. Strange creatures now emerge from below. The villagers fight every day to protect what remains of their home."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
