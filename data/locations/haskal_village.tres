[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "haskalVillage"
location_name = "Hascal Village"
description = "A hidden mining village tucked in the valley. Gold and gemstones fuel the lives of its people."
lore = "Hascal Village was founded by miners who discovered the largest gold vein in the region. But the wealth they gained came at a terrible price. Mines dug too deep opened a gateway to another dimension filled with strange creatures. The villagers must fight every day to protect their mines from the threats emerging from the darkness below."
