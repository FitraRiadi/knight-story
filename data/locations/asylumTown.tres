[resource]
script = ExtResource("1_script")
location_id = "asylumTown"
location_name = "Asylum Town"
description = "A settlement built around a asylum for the afflicted and the cursed."
lore = "Asylum Town grew from a simple hospital into a bustling community. The healers here specialize in treating magical afflictions. The town square features a fountain said to purify those who drink from it. Many seek refuge here, hoping for a cure to their ailments."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
