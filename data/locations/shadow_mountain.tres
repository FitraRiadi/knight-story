[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "shadowMountain"
location_name = "Shadow Mountain"
description = "A mountain shrouded in eternal darkness. Its peak is never visible from afar."
lore = "Shadow Mountain is the tallest peak in this region, yet its summit is forever hidden beneath unmoving dark clouds. Legend says this mountain was home to an ancient sorcerer who sacrificed his sight to see into other worlds. The energy from those realms seeps out, creating shadows that move and live on their own. The villagers believe that anyone who reaches the top will gain the power to command the shadows."
