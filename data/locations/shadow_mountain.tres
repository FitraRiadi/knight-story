[resource]
script = ExtResource("1_script")
location_id = "shadowMountain"
location_name = "Shadow Mountain"
description = "A mountain shrouded in eternal darkness. Its peak is never visible from afar."
lore = "The tallest peak in this region, yet its summit is forever hidden beneath dark clouds. Legend says an ancient sorcerer sacrificed his sight here to see into other worlds. The energy from those realms seeps out, creating shadows that move on their own."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
