[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "shadowMountain"
location_name = "Shadow Mountain"
description = "Gunung yang diselimuti kegelapan abadi. Puncaknya tidak pernah terlihat dari kejauhan."
lore = "Shadow Mountain adalah gunung tertinggi di wilayah ini, namun puncaknya selalu tertutup awan gelap yang tidak pernah bergerak. Konon, gunung ini adalah tempat tinggal seorang penyihir kuno yang mengorbankan penglihatannya untuk melihat dunia lain. Energi dari dunia lain merembes keluar dari gunung ini, menciptakan bayangan yang hidup dan bergerak sendiri. Penduduk percaya bahwa siapa pun yang mencapai puncak akan mendapatkan kekuatan untuk menguasai bayangan."
