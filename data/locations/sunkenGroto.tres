[resource]
script = ExtResource("1_script")
location_id = "sunkenGroto"
location_name = "Sunken Groto"
description = "A network of flooded caves beneath the eastern cliffs, filled with ancient relics."
lore = "The Sunken Groto was once a thriving underground city. Earthquakes caused the caves to flood, submerging most of the structures. Divers report seeing glowing crystals in the deepest chambers. Some believe the groto holds the key to restoring a lost civilization."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
