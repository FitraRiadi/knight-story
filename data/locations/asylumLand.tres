[resource]
script = ExtResource("1_script")
location_id = "asylumLand"
location_name = "Asylum Land"
description = "Vast plains surrounding Asylum Town, dotted with abandoned structures."
lore = "The lands around Asylum Town are haunted by echoes of the past. Abandoned buildings stand as reminders of a forgotten era. Strange creatures roam the plains under the cover of night. Travelers are advised to carry protective talismans when venturing beyond the town walls."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
