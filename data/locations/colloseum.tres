[resource]
script = ExtResource("1_script")
location_id = "colloseum"
location_name = "Colosseum"
description = "An ancient battle arena that still stands strong. Blood and victory dance here for eternity."
lore = "Once a place of entertainment for the nobles of a long-collapsed kingdom. Now it serves as a proving ground for nameless fighters. No one knows who built it, or why it still stands while the kingdom vanished. The blood spilled here never truly dries."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
