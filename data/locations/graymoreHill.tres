[resource]
script = ExtResource("1_script")
location_id = "graymoreHill"
location_name = "Graymore Hill"
description = "Rolling hills outside Graymore, home to farmers and scattered homesteads."
lore = "The gentle slopes of Graymore Hill stretch for miles beyond the city walls. Small farming communities dot the landscape, producing grain and livestock. bandits occasionally raid the isolated homesteads, making travel dangerous after dark."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
