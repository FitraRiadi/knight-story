[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "forestOfShadows"
location_name = "Forest of Shadows"
description = "A dark forest filled with moving shadows. Sunlight never pierces through its canopy."
lore = "The Forest of Shadows is the oldest forest in this region. Its trees grow so tall that their branches touch, forming an eternal dark canopy. Locals believe the shadows in this forest are not mere reflections of light, but living entities. They hunt lost souls who venture too deep. Even thieves refuse to enter here."
