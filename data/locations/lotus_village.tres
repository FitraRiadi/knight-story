[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "lotusVillage"
location_name = "Lotus Village"
description = "A remote village surrounded by white lotus flowers. The last shelter for weary travelers."
lore = "Lotus Village was built upon the ruins of an ancient temple dedicated to the god of journeys. Its people believe that the lotus flowers blooming at night are the spirits of travelers long gone, watching over the village from harm. For centuries, this village has been the only safe haven in the heart of a dark forest."
