[resource]
script = ExtResource("1_script")
location_id = "lotusVillage"
location_name = "Lotus Village"
description = "A remote village surrounded by white lotus flowers. The last shelter for weary travelers."
lore = "Built upon the ruins of an ancient temple dedicated to the god of journeys. The villagers believe the lotus flowers blooming at night are spirits of fallen travelers watching over them. For centuries, it has been the only safe haven in the heart of a dark forest."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
