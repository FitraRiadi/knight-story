[resource]
script = ExtResource("1_script")
location_id = "sunkenCity"
location_name = "Sunken City"
description = "The remains of a once-great city, now half-submerged in dark waters."
lore = "Sunken City was the capital of an ancient empire that ruled the seas. Its towers pierce the water's surface like broken teeth. Beneath the waves lie treasures and dangers in equal measure. Few return from expeditions into the city's depths unchanged."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
