[resource]
script = ExtResource("1_script")
location_id = "graymore"
location_name = "Graymore"
description = "A fortified city at the edge of the known world, ruled by the Gray Council."
lore = "Graymore stands as the last bastion of civilization before the untamed wilds. Its gray stone walls have withstood centuries of conflict. The Council maintains order through strict laws and ancient traditions. Many travelers seek refuge within its gates, but few are granted entry."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
