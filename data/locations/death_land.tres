[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "deathLand"
location_name = "Death Land"
description = "A dead land shrouded in thick fog. No life lasts long here."
lore = "Once fertile farmland before the Great War destroyed everything. The fire that scorched this land burned so hot it froze the souls within. The fog that blankets it is the weeping of restless spirits. Anyone who enters must be prepared to never return."
