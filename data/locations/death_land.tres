[gd_resource type="Resource" script_class="LocationData" format=3]

[ext_resource type="Script" path="res://scripts/data/location_data.gd" id="1_script"]

[resource]
script = ExtResource("1_script")
location_id = "deathLand"
location_name = "Death Land"
description = "Tanah mati yang diselimuti kabut tebal. Tidak ada kehidupan yang bertahan lama di sini."
lore = "Death Land dulunya adalah ladang yang subur sebelum perang besar menghancurkan segalanya. Api yang membakar dataran ini begitu panas hingga membekukan jiwa-jiwa yang terjebak di dalamnya. Kabut yang menyelimuti bukan sekadar uap air, melainkan tangisan arwah-arwah yang tidak bisa menemukan kedamaian. Siapa pun yang masuk ke sini harus bersiap untuk tidak pernah kembali."
