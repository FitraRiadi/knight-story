[resource]
script = ExtResource("1_script")
location_id = "grayAltar"
location_name = "Gray Altar"
description = "An ancient stone altar hidden deep within the hills, radiating faint energy."
lore = "The Gray Altar predates Graymore by millennia. Its origin remains a mystery to scholars. Strange phenomena occur during the equinox, with lights dancing above the stones. Some believe it serves as a gateway to another realm."
events = Array[ExtResource("2_event")]([ExtResource("2_event"), ExtResource("3_event"), ExtResource("4_event"), ExtResource("5_event"), ExtResource("6_event"), ExtResource("7_event")])
